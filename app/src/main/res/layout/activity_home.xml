<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#030B15">

        <LinearLayout
            android:id="@+id/home"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="25dp">

                <TextView
                    android:id="@+id/btnMenu"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:gravity="center"
                    android:text="☰"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Campus WorkHub"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="24sp"
                    android:layout_marginStart="10dp" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lista de trabajos disponibles"
                android:textColor="#8B97A8"
                android:textSize="14sp"
                android:layout_marginBottom="20dp" />

            <Button
                android:id="@+id/btnCreatePost"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="Crear publicación"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="#0D6EFD" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerPosts"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="18dp"
                android:clipToPadding="false"
                android:paddingBottom="12dp" />

            <!-- BARRA INFERIOR 4 OPCIONES -->
            <LinearLayout
                android:id="@+id/bottomMenu"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_bottom_menu"
                android:padding="6dp">

                <TextView
                    android:id="@+id/btnInicio"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="⌂\nInicio"
                    android:textColor="#0D6EFD"
                    android:textStyle="bold"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnBuscar"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="⌕\nBuscar"
                    android:textColor="#8B97A8"
                    android:textSize="12sp" />


                <TextView
                    android:id="@+id/btnPerfil"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="♙\nPerfil"
                    android:textColor="#8B97A8"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- BOTON REFRESH FLOTANTE -->
        <TextView
            android:id="@+id/btnRefresh"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="28dp"
            android:layout_marginBottom="92dp"
            android:gravity="center"
            android:text="↻"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:background="@drawable/bg_btn_refresh"
            android:elevation="8dp"
            android:clickable="true"
            android:focusable="true" />

    </FrameLayout>

    <!-- MENÚ LATERAL -->
    <LinearLayout
        android:id="@+id/menuLateral"
        android:layout_width="310dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="#08111F"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="35dp">

            <TextView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:gravity="center"
                android:text="💼"
                android:textSize="30sp"
                android:background="@drawable/bg_logo_login" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Campus WorkHub"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Conectando oportunidades"
                    android:textColor="#9CA3AF"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView android:id="@+id/menuDashboard" android:layout_width="match_parent" android:layout_height="50dp" android:text="⌂   Dashboard" android:textColor="#FFFFFF" android:textSize="18sp" android:gravity="center_vertical" />
        <TextView android:id="@+id/menuBuscar" android:layout_width="match_parent" android:layout_height="50dp" android:text="⌕   Buscar trabajos" android:textColor="#FFFFFF" android:textSize="18sp" android:gravity="center_vertical" />
        <TextView android:id="@+id/menuPostulaciones" android:layout_width="match_parent" android:layout_height="50dp" android:text="▣   Mis postulaciones" android:textColor="#FFFFFF" android:textSize="18sp" android:gravity="center_vertical" />
        <TextView android:id="@+id/menuPublicaciones" android:layout_width="match_parent" android:layout_height="50dp" android:text="◪   Mis publicaciones" android:textColor="#FFFFFF" android:textSize="18sp" android:gravity="center_vertical" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1E293B"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp" />

        <TextView android:id="@+id/menuConfiguracion" android:layout_width="match_parent" android:layout_height="50dp" android:text="⚙   Configuración" android:textColor="#FFFFFF" android:textSize="18sp" android:gravity="center_vertical" />
        <TextView android:id="@+id/menuCerrarSesion" android:layout_width="match_parent" android:layout_height="50dp" android:text="⇱   Cerrar sesión" android:textColor="#FFFFFF" android:textSize="18sp" android:gravity="center_vertical" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>